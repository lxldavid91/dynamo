# Dockerfile for AFD End-to-End Demo

FROM python:3.11-slim

WORKDIR /app

# Install dependencies
RUN pip install --no-cache-dir numpy

# Copy demo script
COPY afd_e2e_demo.py .

# Run benchmark
CMD ["python", "afd_e2e_demo.py", "--iterations", "5"]
